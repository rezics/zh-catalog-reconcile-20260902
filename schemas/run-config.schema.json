{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "rezicsRef": {
      "type": "string",
      "minLength": 1
    },
    "sourcePolicy": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "book"
        },
        "metadataLanguagesExactly": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "zh"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "status": {
          "type": "string",
          "const": "published"
        },
        "visibility": {
          "type": "string",
          "const": "public"
        },
        "moderationStatus": {
          "type": "string",
          "const": "approved"
        },
        "deleted": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "kind",
        "metadataLanguagesExactly",
        "status",
        "visibility",
        "moderationStatus",
        "deleted"
      ],
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "string",
      "const": "rezics-only-no-external-metadata"
    },
    "evidenceMode": {
      "type": "string",
      "const": "online-batched"
    },
    "applyState": {
      "type": "string",
      "const": "locked"
    },
    "decisionPolicyRevision": {
      "default": "legacy-v1",
      "type": "string",
      "enum": [
        "legacy-v1",
        "evidence-grounded-v2",
        "evidence-claims-v3"
      ]
    },
    "workerProtocol": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "codex"
                },
                "model": {
                  "type": "string",
                  "const": "gpt-5.6-luna"
                },
                "promptRevision": {
                  "type": "string",
                  "const": "full-online-luna-v2"
                },
                "proposalProtocol": {
                  "type": "string",
                  "const": "claim-local-citations-v1"
                }
              },
              "required": [
                "kind",
                "model",
                "promptRevision",
                "proposalProtocol"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "codex"
                },
                "model": {
                  "type": "string",
                  "const": "gpt-5.6-luna"
                },
                "promptRevision": {
                  "type": "string",
                  "const": "full-online-luna-v3"
                },
                "proposalProtocol": {
                  "type": "string",
                  "const": "claim-local-citations-v2"
                }
              },
              "required": [
                "kind",
                "model",
                "promptRevision",
                "proposalProtocol"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceStart": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fromRunId": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "afterCreatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "afterUnitId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "fromRunId",
            "afterCreatedAt",
            "afterUnitId"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "onlineBatchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxCandidatesPerPacket": {
      "type": "integer",
      "minimum": 2,
      "maximum": 50
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "cutoff",
    "rezicsRef",
    "sourcePolicy",
    "networkPolicy",
    "evidenceMode",
    "applyState",
    "decisionPolicyRevision",
    "workerProtocol",
    "sourceStart",
    "onlineBatchSize",
    "maxCandidatesPerPacket"
  ],
  "additionalProperties": false
}
