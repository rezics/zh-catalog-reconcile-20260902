# Preferred on an authorized REZICS operator workstation. The runner reads the
# production monitoring profile at runtime and never copies its password here.
REZICS_DATABASE_SECRET_FILE=

# Defaults to monitoring. Use runtime only when the existing monitoring role
# cannot read the catalog. Runtime mode forces default_transaction_read_only=on
# at connection startup and SET TRANSACTION READ ONLY before every query batch.
# REZICS_DATABASE_SECRET_PROFILE=runtime

# Optional when the operator workstation must pin SSH to a specific network
# interface. The SSH process resolves and binds that interface's active IPv4.
REZICS_SSH_BIND_INTERFACE=

# Alternative: a dedicated PostgreSQL role with CONNECT and SELECT only.
# Configure exactly one database source and never commit the real URL.
# REZICS_DATABASE_READONLY_URL=postgresql://catalog_reconcile_reader:REDACTED@127.0.0.1:5432/rezics
